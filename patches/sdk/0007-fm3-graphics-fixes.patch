+inline std::atomic<uint32_t> upload_kb_by_mb[512];
+inline std::atomic<uint32_t> upload_count_by_mb[512];
+
+class Scope {
+ public:
+  explicit Scope(Counter& counter) : counter_(counter), start_(std::chrono::steady_clock::now()) {}
+  ~Scope() {
+    counter_.count.fetch_add(1, std::memory_order_relaxed);
+    counter_.ns.fetch_add(
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                     std::chrono::steady_clock::now() - start_)
+                     .count()),
+        std::memory_order_relaxed);
+  }
+
+ private:
+  Counter& counter_;
+  std::chrono::steady_clock::time_point start_;
+};
