+// FM3 research build: see d3d12_async_submission.
+class Fm3SubmitWorker {
+ public:
+  struct Job {
+    std::vector<uintmax_t> stream;
+    ID3D12CommandAllocator* allocator = nullptr;
+    uint64_t submission = 0;
+  };
+
+  void Start(const DeferredCommandList* replayer, ID3D12GraphicsCommandList* list,
+             ID3D12GraphicsCommandList1* list_1, ID3D12CommandQueue* queue, ID3D12Fence* fence) {
+    Stop();
+    replayer_ = replayer;
+    list_ = list;
+    list_1_ = list_1;
+    queue_ = queue;
+    fence_ = fence;
+    stop_ = false;
+    thread_ = std::thread([this] { Main(); });
+  }
+
+  void Stop() {
+    if (!thread_.joinable()) {
+      return;
+    }
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    work_.notify_all();
+    thread_.join();
+  }
+
+  bool running() const { return thread_.joinable(); }
+
+  // Storage for the next stream, reusing a finished job's allocation.
+  std::vector<uintmax_t> TakeSpare() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<uintmax_t> spare;
+    if (!spares_.empty()) {
+      spare = std::move(spares_.back());
+      spares_.pop_back();
+    }
+    return spare;
+  }
+
+  void Push(Job&& job) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    // Never let the graphics thread run far ahead of the driver.
+    done_.wait(lock, [this] { return jobs_.size() < 3; });
+    jobs_.push_back(std::move(job));
+    lock.unlock();
+    work_.notify_one();
+  }
+
+  // Returns once everything pushed so far is on the queue.
+  void Flush() {
+    if (!thread_.joinable()) {
+      return;
+    }
+    std::unique_lock<std::mutex> lock(mutex_);
+    done_.wait(lock, [this] { return jobs_.empty() && !busy_; });
+  }
+
+ private:
+  void Main() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    while (true) {
+      work_.wait(lock, [this] { return stop_ || !jobs_.empty(); });
+      if (jobs_.empty()) {
+        return;
+      }
+      Job job = std::move(jobs_.front());
+      jobs_.pop_front();
+      busy_ = true;
+      lock.unlock();
+      done_.notify_all();
+      {
+        fm3stats::Scope scope(fm3stats::submit_worker);
+        job.allocator->Reset();
+        list_->Reset(job.allocator, nullptr);
+        replayer_->ExecuteStream(job.stream.data(), job.stream.size(), list_, list_1_);
+        list_->Close();
+        ID3D12CommandList* lists[] = {list_};
+        queue_->ExecuteCommandLists(1, lists);
+        queue_->Signal(fence_, job.submission);
+      }
+      job.stream.clear();
+      lock.lock();
+      if (spares_.size() < 4) {
+        spares_.push_back(std::move(job.stream));
+      }
+      busy_ = false;
+      done_.notify_all();
+    }
+  }
+
+  std::thread thread_;
+  std::mutex mutex_;
+  std::condition_variable work_, done_;
+  std::deque<Job> jobs_;
+  std::vector<std::vector<uintmax_t>> spares_;
+  bool busy_ = false;
+  bool stop_ = false;
+  const DeferredCommandList* replayer_ = nullptr;
+  ID3D12GraphicsCommandList* list_ = nullptr;
+  ID3D12GraphicsCommandList1* list_1_ = nullptr;
+  ID3D12CommandQueue* queue_ = nullptr;
+  ID3D12Fence* fence_ = nullptr;
+};
