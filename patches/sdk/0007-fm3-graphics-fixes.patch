+                                             D3D12_QUERY_TYPE_OCCLUSION, host_index, 1,
+                                             occlusion_query_readback_.Get(),
+                                             sizeof(uint64_t) * host_index);
+  if (occlusion_pending_tiles_.size() < 64) {
+    occlusion_pending_tiles_.push_back({sample_count_address, host_index});
+  }
